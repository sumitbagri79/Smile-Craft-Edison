---
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";
import BaseLayout from "@/layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<section class="site-hero site-container py-16 md:py-28">
  <div class="grid gap-8 lg:grid-cols-2 items-center">
    <div>
      <h1 class="h1"> Modern Dental Care for Your Whole Family</h1>
      <p class="lead mt-4 max-w-2xl">
        Compassionate, modern dentistry in Edison — preventive care, implants, crowns, and cosmetic smiles. New patients welcome.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/contact">Book an appointment</a>
        {siteData.phone ? (
          <a class="btn btn-outline" href={`tel:${siteData.phone}`}>Call {siteData.phone}</a>
        ) : (
          <a class="btn btn-outline" href="/contact">Contact us</a>
        )}
      </div>

      <div class="mt-6 text-sm text-muted-foreground">
        <span class="font-semibold">Open:</span>
        {siteData.openingHours ? siteData.openingHours.join(" • ") : "Mon–Fri 8:30–17:00"}
      </div>
    </div>

    <div class="hidden md:block">
      <img src="/images/hero/dental-hero.jpg" alt="Smiling dentist and patient" class="rounded-xl shadow-lg object-cover w-full h-[340px]" />
    </div>
  </div>
</section>
